{
	"name": "@trajectonomics/tooling",
	"version": "0.0.0-development",
	"description": "Shared Biome and TypeScript presets, GritQL plugins, and reusable GitHub Actions workflows for Trajectonomics",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trajectonomics/cicd.git"
	},
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=20.0.0"
	},
	"exports": {
		".": {
			"biome": "./biome-manifest.json"
		},
		"./tsconfig/base.json": "./tsconfig/base.json",
		"./tsconfig/web.json": "./tsconfig/web.json",
		"./package.json": "./package.json"
	},
	"files": [
		"biome-manifest.json",
		"biome",
		"plugins",
		"tsconfig"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"tag": "latest"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun run test && bun run lint:package",
		"lint:package": "publint --strict",
		"skills:check": "bunx skills@latest check",
		"skills:update": "bunx skills@latest update"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/bun": "^1.4.4",
		"publint": "^0.3.25",
		"typescript": "^7.0.2"
	}
}
