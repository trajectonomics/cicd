#!/bin/sh
# Direct-commit guard: refuse any push that updates main or master, including
# HEAD:main from a feature branch and a deletion. An accident guard, not branch
# protection: --no-verify bypasses it.
# Activate once per clone: git config core.hooksPath .githooks

refuse() {
	cat >&2 <<'MESSAGE'
Direct changes to main are not allowed. Create `feat/*`, `fix/*` or `docs/*` and open a PR.
MESSAGE
	exit 1
}

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/heads/main | refs/heads/master) refuse ;;
	esac
done
